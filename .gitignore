# Build output and simulation dumps (the root out/ holds every run's caches;
# the canonical profiling state lives there too, untracked by design)
build/
out/

# Simulation footage stays local: videos are rendered into results/ folders by
# the demos and gates but never committed (rule set 2026-10-13).
*.mp4

# Rendered frame sequences and their state caches. Full paths on purpose - a
# pattern containing a slash is
# anchored to this file's folder, so the bare "results/..." form silently
# matched nothing (the bug Aniso carried for these folders).
results/2d/droplet_frames/
results/2d/droplet_states/
results/2d/three_flips_frames/
results/3d/p2g/frames/

# Python
__pycache__/
*.pyc
.venv/

# Editors
.vs/
.vscode/
*.user
